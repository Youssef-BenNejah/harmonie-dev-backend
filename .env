# -- App --
APP_PORT=8080
APP_ENV=dev
FRONTEND_URL=http://localhost:3000

# -- MongoDB Atlas Cluster --
DB_CLUSTER_URL=adminfacter.r0rwc.mongodb.net
DB_NAME=harmoniedev
DB_USERNAME=youssef
DB_PASSWORD=LHMn1MSddYD8vHE5

# -- JWT - RS256 Keys (base64-encoded) --
# Generate:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem   ->  paste as JWT_PRIVATE_KEY
#   base64 -w 0 public.pem    ->  paste as JWT_PUBLIC_KEY
JWT_PRIVATE_
JWT_PUBLIC_
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# -- Redis --
# Port 6380 (not 6379) on purpose: this host also runs an unrelated project's Redis container
# bound to 6379, and our own docker-compose redis isn't exposed to the host at all internally
# (the app container talks to it as "redis:6379" — see docker-compose.yml's REDIS_HOST override).
# This value is only for running the backend locally (e.g. from IntelliJ) outside Docker.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=attia

# -- Security --
BCRYPT_STRENGTH=12
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:5180,https://harmonie-dev.netlify.app,https://hxm0qf64-8081.euw.devtunnels.ms
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# -- Actuator --
ACTUATOR_USERNAME=admin
ACTUATOR_PASSWORD=securepassword


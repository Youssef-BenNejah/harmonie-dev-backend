# -- App --
APP_PORT=8080
APP_ENV=dev
FRONTEND_URL=https://harmonie-dev.netlify.app

# -- MongoDB Atlas Cluster --
DB_CLUSTER_URL=<cluster>.mongodb.net
DB_NAME=harmoniedev
DB_USERNAME=<username>
DB_PASSWORD=<password>

# -- JWT - RS256 Keys (base64-encoded) --
# Generate:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem   ->  paste as JWT_PRIVATE_KEY
#   base64 -w 0 public.pem    ->  paste as JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=<base64_encoded_RSA_private_key>
JWT_PUBLIC_KEY=<base64_encoded_RSA_public_key>
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# -- Redis --
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -- Security --
BCRYPT_STRENGTH=12
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# -- Actuator --
ACTUATOR_USERNAME=admin
ACTUATOR_PASSWORD=securepassword

# -- Mail (SMTP) --
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp_username>
SPRING_MAIL_PASSWORD=<smtp_app_password>
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM_NAME=Harmonie-dev

# -- Seed admin (created on first startup if no ADMIN user exists) --
SEED_ADMIN_EMAIL=admin@harmonie-dev.tn
SEED_ADMIN_PASSWORD=<strong_password>
